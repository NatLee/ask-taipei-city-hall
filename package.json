{
  "name": "ask-taipei-city-hall",
  "private": true,
  "version": "2.0.0",
  "description": "問問台北市政府：在瀏覽器裡查台北市政 FAQ，也可以用自己的 Claude API key 讓 AI 整理答案。2017 台北市政 ChatBot 應用競賽作品的 2026 重製版。",
  "license": "Apache-2.0",
  "homepage": "https://natlee.github.io/ask-taipei-city-hall/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NatLee/ask-taipei-city-hall.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:build": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/data/build.ts",
    "data:sample": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/data/build.ts --offline scripts/data/fixtures --min-entries 1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "lucide-react": "^1.67.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "htmlparser2": "^12.0.0",
    "tailwindcss": "^4.3.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
